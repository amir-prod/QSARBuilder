# Required by the agentic CLI workflow; optional for the Streamlit workflow.
OPENAI_API_KEY="your_key_here"

# Model name. OPENAI_MODEL is still honoured for backwards compatibility.
QSAR_LLM_MODEL="gpt-4o-mini"

# --- Optional ---

# Point at any OpenAI-compatible server (vLLM, Ollama, OpenRouter, Azure) to use a
# local or self-hosted model without code changes.
# QSAR_LLM_BASE_URL="http://localhost:11434/v1"
# QSAR_LLM_API_KEY="ollama"

# Registered provider name. Defaults to "openai".
# QSAR_LLM_PROVIDER="openai"

# Sampling temperature for agent reasoning. Defaults to 0.
# QSAR_LLM_TEMPERATURE="0"

# Preferred web-search backend for the agents' search tool. Without it the tool
# falls back to DuckDuckGo, and returns an empty result set when offline.
# TAVILY_API_KEY="your_key_here"
